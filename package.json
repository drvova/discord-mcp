{
    "name": "discord-mcp",
    "version": "0.0.1",
    "description": "Model Context Protocol (MCP) server for Discord API integration",
    "main": "dist/bootstrap.js",
    "type": "module",
    "engines": {
        "node": ">=22.12"
    },
    "bin": {
        "discord-mcp": "./dist/bootstrap.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "rslib build",
        "test": "rslib build && rstest run",
        "test:watch": "rslib build && rstest watch",
        "lint": "rslint",
        "typecheck": "rslint --type-check-only",
        "check": "rslint --type-check",
        "dev": "npm run dev:pretty",
        "dev:pretty": "rslib build && cross-env LOG_STYLE=pretty concurrently --raw \"rslib build --watch\" \"node --watch dist/bootstrap.js\"",
        "dev:json": "rslib build && cross-env LOG_STYLE=json concurrently --raw \"rslib build --watch\" \"node --watch dist/bootstrap.js\"",
        "start": "node dist/bootstrap.js",
        "web": "cross-env MCP_HTTP_PORT=1455 node dist/bootstrap.js",
        "prepare": "rslib build"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/sashathelambo/discord-mcp.git"
    },
    "keywords": [
        "mcp",
        "discord",
        "discord-bot",
        "model-context-protocol"
    ],
    "author": "SaseQ",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/sashathelambo/discord-mcp/issues"
    },
    "homepage": "https://github.com/sashathelambo/discord-mcp#readme",
    "dependencies": {
        "@discordjs/opus": "^0.10.0",
        "@discordjs/voice": "^0.19.2",
        "@hono/node-server": "^1.19.17",
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@opentelemetry/api": "^1.9.0",
        "@opentelemetry/auto-instrumentations-node": "^0.75.0",
        "@opentelemetry/exporter-prometheus": "^0.217.0",
        "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
        "@opentelemetry/resources": "~2.7.1",
        "@opentelemetry/sdk-node": "^0.217.0",
        "acorn": "^8.19.0",
        "discord.js": "^14.27.0",
        "dotenv": "^17.2.0",
        "hono": "^4.13.14",
        "pino": "^9.9.5",
        "pino-pretty": "^13.1.2",
        "undici": "^6.29.1",
        "ws": "^8.22.0",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@rslib/core": "^1.0.4",
        "@rslint/core": "^0.9.5",
        "@rstest/core": "^0.12.5",
        "@types/node": "^24.0.15",
        "@types/ws": "^8.18.2",
        "concurrently": "^9.2.1",
        "cross-env": "^7.0.3"
    }
}
